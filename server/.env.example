# Server environment variables
# Copy to .env in the server/ directory

GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated allowed origins (set this in production!)
# Example: ALLOWED_ORIGINS=https://glossos.netlify.app,https://glossos.web.app
# ALLOWED_ORIGINS=*

# Port (Cloud Run sets this automatically via PORT env var)
# PORT=8080
