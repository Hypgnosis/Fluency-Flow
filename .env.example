# Copy to .env.local for local development (`npm run dev`).

# === Gemini API Key ===
# Local `npm run dev`: the app calls Gemini directly with this key (dev server only).
# Production (Netlify): set GEMINI_API_KEY in Netlify > Site configuration > Environment variables.
#   It is used only by the Netlify Functions in netlify/functions and is NEVER built into the
#   website (vite.config.ts strips it from production builds and fails the build if it leaks).
GEMINI_API_KEY=your_gemini_api_key_here

# === Firebase Configuration ===
# FIREBASE_PROJECT_ID is also read by the Netlify Functions to verify sign-ins.
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# === Optional model overrides ===
# Voice tutor (Live API). Default gemini-3.8-live; falls back to gemini-3.1-flash-live-preview, then
# gemini-2.5-flash-native-audio-latest if a model cannot start.
# GEMINI_LIVE_MODEL=gemini-3.8-live
# Lens Teacher and other text features (fallbacks: gemini-3.5-flash, gemini-2.5-flash, gemini-3.5-flash-lite)
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# === Optional server-side settings (Netlify Functions) ===
# GEMINI_TEXT_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite   # models /api/* may call
# API_RATE_LIMIT_PER_MIN=30                                    # per signed-in user

# === Plans and payments (Netlify Functions; see netlify/lib/billing/) ===
# Limits are on by default: free users get 5 AI minutes a month. Set these in Netlify, not here.
# OWNER_EMAILS=you@example.com              # verified sign-in emails with unlimited use
# STRIPE_SECRET_KEY=sk_test_...             # Stripe > Developers > API keys
# STRIPE_WEBHOOK_SECRET=whsec_...           # webhook to https://<site>/api/billing/webhook
#   events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid
# PREPAY_FLOAT_USD=5                        # what you pre-loaded on Gemini Prepay before revenue
# MAX_SPEND_SHARE=0.8                       # Gemini may cost at most this share of net revenue
# FREE_BUDGET_USD=3                         # monthly cap for all free users together
# USD_MXN=19                                # exchange rate for the economics
# BILLING_ENFORCE=off                       # emergency switch: turns the limits off

# === Optional: self-hosted WebSocket proxy (server/) ===
# Not needed on Netlify. Only set this if you deploy server/ yourself.
# VITE_WS_PROXY_URL=wss://your-proxy.example.com
