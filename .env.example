# === WebSocket Proxy (PRODUCTION) ===
# Set this to your deployed proxy URL to keep the Gemini API key server-side.
# When set, GEMINI_API_KEY is NOT needed in the client .env.
# Example: VITE_WS_PROXY_URL=wss://glossos-proxy-abcdefg-uc.a.run.app
# VITE_WS_PROXY_URL=

# === Gemini API Key (DEVELOPMENT ONLY) ===
# Only needed when VITE_WS_PROXY_URL is not set (local development).
# WARNING: This key will be embedded in the client bundle — never use in production!
GEMINI_API_KEY=your_gemini_api_key_here

# === Firebase Configuration ===
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
