rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user (including anonymous guests) can only read and write their own data:
    // users/{uid}/sessions, users/{uid}/mistakes, users/{uid}/vocabulary, users/{uid}/lessons.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
